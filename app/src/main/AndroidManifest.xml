<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Enumerating albums means listing the whole images collection, which the platform
      does not serve to an app that has not been granted it. Without these the album
      picker comes up empty. Photos picked through the system photo picker do not need
      them; they are requested lazily, only when the album route is actually used.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Merge pairs a still with a separate video file, so it queries MediaStore.Video. That
      collection is gated separately from images: READ_MEDIA_IMAGES does not open it, and
      without this every sibling query returns zero rows, so merge finds no video for any
      input while appearing to work normally.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!--
      Android 14+ photo-picker URIs do not expose RELATIVE_PATH, which merge needs in order
      to search the right folder. This permission extends the picker grant to the underlying
      MediaStore rows, letting the app recover each picked image's folder so a sibling video
      can be located. Best-effort: pairing also works without it when the app already has
      album access.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotionSwap">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MotionSwap"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>